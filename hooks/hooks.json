{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/sloptimize.mjs hook-status --dir .sloptimize 2>/dev/null || true",
